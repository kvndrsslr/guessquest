{
	"name": "guess-quest",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "MIT",
	"author": {
		"name": "Kevin Dreßler"
	},
	"scripts": {
		"dev": "npm-run-all --parallel dev:frontend dev:backend",
		"dev:frontend": "vite dev",
		"dev:backend": "zig build start",
		"build": "npm-run-all --serial build:frontend build:backend",
		"build:ci": "npm-run-all --serial build:frontend build:backend:ci",
		"build:all": "npm-run-all --serial build:frontend build:backend:all",
		"build:frontend": "vite build",
		"build:backend": "zig build --release=fast",
		"build:backend:ci": "zig build --release=fast -Dtarget=aarch64-linux",
		"build:backend:all": "zig build all",
		"preview": "./zig-out/bin/guessquest-server",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"deps": "ncu --peer --interactive --install always",
		"deps:min": "ncu --peer --interactive --install always --minimal"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/medievalsharp": "^5.3.0",
		"@lucide/svelte": "^1.51.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"bits-ui": "^2.19.5",
		"cookie": "^2.0.1",
		"cross-env": "^10.1.0",
		"emoji-picker-element": "^1.29.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"npm-check-updates": "^23.1.0",
		"npm-run-all": "^4.1.5",
		"phosphor-svelte": "^3.1.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"sass-embedded": "^1.105.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vite-plugin-devtools-json": "^1.1.0"
	},
	"packageManager": "pnpm@12.8.1",
	"volta": {
		"node": "26.10.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
